    },
    "text_3": {
      "type": "string",
      "title": "Absatz 3"
    },
    "text_4": {
      "type": "string",
      "title": "Absatz 4"
    },
    "foto_url": {
      "type": "string",
      "title": "Profilfoto URL"
    },
    "voice_url": {
      "type": "string",
      "title": "Audio URL (pers\u00f6nliche Nachricht)"
    },
    "voice_label": {
      "type": "string",
